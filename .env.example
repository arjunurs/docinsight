# OpenAI API Key - Required (embeddings, and OpenAI answer models)
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic API Key - Required for the default answer model (claude-haiku-5-5) and other claude-* models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional settings
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# Answer model: any OpenAI chat model, or a Claude model (claude-haiku-5-5, claude-sonnet-5-5, ...)
# LLM_MODEL=claude-haiku-5-5
# Set LLM_MODEL=gpt-6-luna (or another OpenAI model) to run with an OpenAI key only
# Reasoning models (GPT-5 and later): none, low, medium, high
# LLM_REASONING_EFFORT=none
# Only used by older models such as gpt-4o-mini; reasoning models run at 1.0
# LLM_TEMPERATURE=0.0
# EMBEDDING_MODEL=text-embedding-3-small
# Retrieval: hybrid (BM25 + dense, the default) or dense (vector search only)
# RETRIEVAL_MODE=hybrid
# Hybrid fusion: score (weighted sum of per-query scaled scores, the default) or rrf
# HYBRID_FUSION=score
# HYBRID_DENSE_WEIGHT=0.7
# Optional reranker (needs: uv sync --extra rerank): minilm, or unset for off
# RERANKER=minilm
# RERANK_CANDIDATES=10
